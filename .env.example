# Nature Vibes Configurator — environment variables
#
# Two groups, and the split matters:
#
#   NEXT_PUBLIC_*  are embedded in the browser bundle and are therefore PUBLIC.
#                  Never put a secret in one.
#   Server secrets are set with `supabase secrets set` and are readable only
#                  inside the submit-quote Edge Function.
#
# Copy to .env.local for development.

# ---------------------------------------------------------------------------
# Browser-visible (safe to publish)
# ---------------------------------------------------------------------------

# demo | production
#
# demo       - quote requests are saved in the visitor's browser and are never
#              sent anywhere. The UI says so explicitly. This is the default,
#              and what the GitHub Pages demo runs.
# production - quote requests are posted to the submit-quote Edge Function, and
#              the success screen appears only after that write is confirmed.
#
# Production is honoured only when the two Supabase values below are also set.
# Without them the app falls back to demo mode rather than claiming a request
# was received.
NEXT_PUBLIC_APP_MODE=demo

# Supabase project. Required for production mode.
# The anon key is meant to be public: since Round 2.1 it can no longer insert
# into quote_requests at all (migration 0002), and cannot read the table. It
# only invokes the Edge Function and the safe summary RPC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile *site* key. Public by design. When unset, no widget
# renders and the boundary skips verification, so the app works without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Static export settings, used by the GitHub Pages build. Leave unset locally.
# NEXT_OUTPUT_EXPORT=1
# NEXT_PUBLIC_BASE_PATH=/nature-vibes

# ---------------------------------------------------------------------------
# Server secrets — Supabase only, NEVER prefixed NEXT_PUBLIC_
# ---------------------------------------------------------------------------
#
#   supabase secrets set NATURE_VIBES_NOTIFY_WEBHOOK_URL="https://hooks.slack.com/..."
#   supabase secrets set TURNSTILE_SECRET_KEY="0x..."
#   supabase secrets set ALLOWED_ORIGINS="https://moeeyani.github.io"
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform and
# must never be set manually in this file or in any NEXT_PUBLIC_ variable.
#
# NATURE_VIBES_NOTIFY_WEBHOOK_URL  where new-lead notifications are posted.
#                                  Replaces Round 2's public webhook variable.
# TURNSTILE_SECRET_KEY             verifies the Turnstile token server-side.
# ALLOWED_ORIGINS                  comma-separated CORS allow-list; defaults to *.
