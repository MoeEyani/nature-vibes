# Nature Vibes Configurator — environment variables
#
# Copy to .env.local for development. Every NEXT_PUBLIC_* value is embedded in
# the client bundle and is therefore public: never put a secret in one.

# demo | production
#
# demo       - quote requests are saved in the visitor's browser and are never
#              sent anywhere. The UI says so explicitly. This is the default.
# production - quote requests are written to Supabase, and the success screen
#              appears only after that write is confirmed.
#
# Production is honoured only when the two Supabase values below are also set.
# Without them the app falls back to demo mode rather than claiming a request
# was received.
NEXT_PUBLIC_APP_MODE=demo

# Supabase project. Required for production mode.
# The anon key is meant to be public; security comes from the RLS policies in
# supabase/migrations/0001_quote_requests.sql. Never expose the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. A webhook notified when a lead is created (Slack incoming webhook,
# Zapier/Make catch hook, or your own endpoint). The database row is the source
# of truth; a notification failure never loses the lead.
# Anything requiring a secret must be called server-side, not from here.
NEXT_PUBLIC_NOTIFY_WEBHOOK_URL=

# Static export settings, used by the GitHub Pages build. Leave unset locally.
# NEXT_OUTPUT_EXPORT=1
# NEXT_PUBLIC_BASE_PATH=/nature-vibes
